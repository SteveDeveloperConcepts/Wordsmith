{
  "name": "wordsmith",
  "productName": "Wordsmith",
  "version": "0.2.0",
  "description": "A private, offline-first writing assistant for macOS and Windows: grammar, spelling, punctuation, sentence, clarity and tone checking with optional AI rewriting.",
  "author": "Steve Vaubell",
  "license": "MIT",
  "homepage": "https://github.com/SteveDeveloperConcepts/Wordsmith",
  "repository": {
    "type": "git",
    "url": "https://github.com/SteveDeveloperConcepts/Wordsmith.git"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/build-live-helper.mjs && electron-vite dev",
    "dev:web": "vite --config vite.web.config.mts",
    "build": "node scripts/build-live-helper.mjs && electron-vite build",
    "build:web": "vite build --config vite.web.config.mts",
    "build:addin": "vite build --config vite.addin.config.mts",
    "build:extension": "vite build --config vite.extension.config.mts --configLoader runner",
    "build:site": "node scripts/build-site.mjs",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e.mjs",
    "test:update": "node scripts/update-test.mjs",
    "test:addin": "node tests/addin/pane.e2e.mjs",
    "test:extension": "node tests/extension/browser/run.mjs",
    "icons": "node scripts/make-icons.mjs",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never -c electron-builder.adhoc.yml",
    "dist:dir": "npm run build && electron-builder --dir --publish never",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@floating-ui/dom": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@tiptap/extensions": "^3.33.0",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/react": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@types/office-js": "^1.0.616",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.2.1",
    "docx": "^9.15.2",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "happy-dom": "^21.0.4",
    "harper.js": "^3.0.0",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.70.0",
    "mammoth": "^1.13.0",
    "marked": "^18.1.3",
    "playwright-core": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "turndown": "^7.2.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wordlist-english": "^1.2.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "koffi": "^3.3.7"
  }
}
