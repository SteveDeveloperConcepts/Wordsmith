<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xsi:type="MailApp">
  <Id>e993d6b7-7672-4467-bf6b-379364ce0ed1</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Wordsmith</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Wordsmith"/>
  <Description DefaultValue="Private grammar and style checks for email drafts. Text stays on your device."/>
  <IconUrl DefaultValue="__ADDIN_BASE_URL__icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="__ADDIN_BASE_URL__icon-128.png"/>
  <SupportUrl DefaultValue="https://github.com/SteveDeveloperConcepts/Wordsmith/issues"/>
  <AppDomains>
    <AppDomain>__ADDIN_ORIGIN__</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.5"/>
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemEdit">
      <DesktopSettings>
        <SourceLocation DefaultValue="__ADDIN_BASE_URL__taskpane.html"/>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadWriteItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit"/>
  </Rule>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.5">
          <bt:Set Name="Mailbox"/>
        </bt:Sets>
      </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <DesktopFormFactor>
            <FunctionFile resid="Pane.Url"/>
            <ExtensionPoint xsi:type="MessageComposeCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="Ws.Group">
                  <Label resid="Group.Label"/>
                  <Control xsi:type="Button" id="Ws.Open">
                    <Label resid="Button.Label"/>
                    <Supertip>
                      <Title resid="Button.Label"/>
                      <Description resid="Button.Tip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.16"/>
                      <bt:Image size="32" resid="Icon.32"/>
                      <bt:Image size="80" resid="Icon.80"/>
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="Pane.Url"/>
                      <SupportsPinning>true</SupportsPinning>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>
      <Resources>
        <bt:Images>
          <bt:Image id="Icon.16" DefaultValue="__ADDIN_BASE_URL__icon-16.png"/>
          <bt:Image id="Icon.32" DefaultValue="__ADDIN_BASE_URL__icon-32.png"/>
          <bt:Image id="Icon.80" DefaultValue="__ADDIN_BASE_URL__icon-80.png"/>
        </bt:Images>
        <bt:Urls>
          <bt:Url id="Pane.Url" DefaultValue="__ADDIN_BASE_URL__taskpane.html"/>
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="Group.Label" DefaultValue="Wordsmith"/>
          <bt:String id="Button.Label" DefaultValue="Check draft"/>
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="Button.Tip" DefaultValue="Check this draft on your device."/>
        </bt:LongStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
